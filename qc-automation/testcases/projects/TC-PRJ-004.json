{
  "id": "TC-PRJ-004",
  "name": "프로젝트 상세 페이지 이동 테스트",
  "description": "프로젝트 목록에서 프로젝트를 클릭하면 상세 페이지로 이동하는지 확인",
  "feature": "projects",
  "priority": "high",
  "tags": ["projects", "detail", "navigation"],

  "preconditions": [
    "사용자가 로그인된 상태",
    "최소 1개 이상의 프로젝트가 존재"
  ],

  "setup": {
    "requiresAuth": true,
    "startUrl": "/projects"
  },

  "steps": [
    {
      "order": 1,
      "action": "navigate",
      "target": "/projects",
      "description": "프로젝트 목록 페이지로 이동"
    },
    {
      "order": 2,
      "action": "wait",
      "type": "selector",
      "selector": "table tbody tr",
      "description": "프로젝트 행이 로드될 때까지 대기"
    },
    {
      "order": 3,
      "action": "click",
      "selector": "table tbody tr:first-child",
      "description": "첫 번째 프로젝트 행 클릭"
    },
    {
      "order": 4,
      "action": "wait",
      "type": "navigation",
      "description": "페이지 이동 대기"
    },
    {
      "order": 5,
      "action": "assert",
      "type": "url_contains",
      "expected": "/projects/",
      "description": "프로젝트 상세 페이지로 이동 확인"
    },
    {
      "order": 6,
      "action": "screenshot",
      "name": "project-detail-page",
      "description": "프로젝트 상세 페이지 스크린샷"
    }
  ],

  "expectedResult": "프로젝트 클릭 시 해당 프로젝트의 상세 페이지로 이동함",

  "createdAt": "2026-01-13T00:00:00Z",
  "updatedAt": "2026-01-13T00:00:00Z"
}
