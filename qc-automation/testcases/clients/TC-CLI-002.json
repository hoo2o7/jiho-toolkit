{
  "id": "TC-CLI-002",
  "name": "고객사 등록 모달 테스트 (법인)",
  "description": "고객사 등록 모달이 올바르게 열리고 법인 고객사 필드가 표시되는지 확인",
  "feature": "clients",
  "priority": "high",
  "tags": ["clients", "create", "modal", "corporate"],

  "preconditions": [
    "사용자가 로그인된 상태",
    "고객사 관리 페이지에서 시작"
  ],

  "setup": {
    "requiresAuth": true,
    "startUrl": "/clients"
  },

  "steps": [
    {
      "order": 1,
      "action": "navigate",
      "target": "/clients",
      "description": "고객사 관리 페이지로 이동"
    },
    {
      "order": 2,
      "action": "click",
      "selector": "button:has-text('고객사 등록')",
      "description": "고객사 등록 버튼 클릭"
    },
    {
      "order": 3,
      "action": "wait",
      "type": "selector",
      "selector": "[role='dialog']",
      "description": "모달이 열릴 때까지 대기"
    },
    {
      "order": 4,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] heading:has-text('고객사 등록')",
      "description": "모달 제목이 표시되는지 확인"
    },
    {
      "order": 5,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] textbox[placeholder*='고객사명을 입력']",
      "description": "고객사명 입력 필드가 표시되는지 확인"
    },
    {
      "order": 6,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] :text('고객 유형 *')",
      "description": "고객 유형 필수 필드 라벨이 표시되는지 확인"
    },
    {
      "order": 7,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] textbox[placeholder*='법인명을 입력']",
      "description": "법인명 입력 필드가 표시되는지 확인 (법인 유형 기본)"
    },
    {
      "order": 8,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] textbox[placeholder*='대표자명을 입력']",
      "description": "대표자명 입력 필드가 표시되는지 확인"
    },
    {
      "order": 9,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] textbox[placeholder*='000-00-00000']",
      "description": "사업자등록번호 입력 필드가 표시되는지 확인"
    },
    {
      "order": 10,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] button:has-text('등록')",
      "description": "등록 버튼이 표시되는지 확인"
    },
    {
      "order": 11,
      "action": "click",
      "selector": "[role='dialog'] button:has-text('Close')",
      "description": "모달 닫기"
    }
  ],

  "expectedResult": "고객사 등록 모달이 올바르게 열리고 법인 고객사 관련 필드가 모두 표시됨",

  "createdAt": "2026-01-13T00:00:00Z",
  "updatedAt": "2026-01-13T00:00:00Z"
}
