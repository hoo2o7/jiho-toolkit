{
  "id": "TC-CLI-005",
  "name": "[US-002] 고객사 유형별 필드 표시 테스트",
  "description": "고객사 등록 시 법인/개인 유형에 따라 다른 필드가 표시되는지 확인 (US-002)",
  "feature": "clients",
  "priority": "high",
  "tags": ["clients", "create", "validation", "us-002"],
  "userStory": "US-002",

  "preconditions": [
    "사용자가 로그인된 상태"
  ],

  "setup": {
    "requiresAuth": true,
    "startUrl": "/clients"
  },

  "steps": [
    {
      "order": 1,
      "action": "navigate",
      "target": "/clients",
      "description": "고객사 관리 페이지로 이동"
    },
    {
      "order": 2,
      "action": "click",
      "selector": "button:has-text('고객사 등록')",
      "description": "고객사 등록 버튼 클릭"
    },
    {
      "order": 3,
      "action": "wait",
      "type": "selector",
      "selector": "[role='dialog']",
      "description": "모달이 열릴 때까지 대기"
    },
    {
      "order": 4,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] textbox[placeholder*='법인명을 입력']",
      "description": "법인 유형일 때 법인명 필드가 표시되는지 확인"
    },
    {
      "order": 5,
      "action": "assert",
      "type": "element_visible",
      "selector": "[role='dialog'] textbox[placeholder*='사업자등록번호']",
      "description": "법인 유형일 때 사업자등록번호 필드가 표시되는지 확인"
    },
    {
      "order": 6,
      "action": "screenshot",
      "name": "client-type-corporate",
      "description": "법인 고객사 유형 스크린샷"
    },
    {
      "order": 7,
      "action": "click",
      "selector": "[role='dialog'] button:has-text('Close')",
      "description": "모달 닫기"
    }
  ],

  "expectedResult": "고객사 유형(법인/개인)에 따라 적절한 필드가 표시됨",

  "createdAt": "2026-01-13T00:00:00Z",
  "updatedAt": "2026-01-13T00:00:00Z"
}
