{
  "id": "TC-DASH-002",
  "name": "대시보드 최근 활동 클릭 테스트",
  "description": "대시보드의 최근 활동 항목을 클릭하면 해당 프로젝트로 이동하는지 확인",
  "feature": "dashboard",
  "priority": "medium",
  "tags": ["dashboard", "activity", "navigation"],

  "preconditions": [
    "사용자가 로그인된 상태",
    "최근 활동 항목이 1개 이상 존재"
  ],

  "setup": {
    "requiresAuth": true,
    "startUrl": "/dashboard"
  },

  "steps": [
    {
      "order": 1,
      "action": "navigate",
      "target": "/dashboard",
      "description": "대시보드 페이지로 이동"
    },
    {
      "order": 2,
      "action": "wait",
      "type": "selector",
      "selector": ":text('최근 활동')",
      "description": "최근 활동 섹션이 로드될 때까지 대기"
    },
    {
      "order": 3,
      "action": "click",
      "selector": "a[href*='/projects/']:first-of-type",
      "description": "첫 번째 최근 활동 항목 클릭"
    },
    {
      "order": 4,
      "action": "wait",
      "type": "navigation",
      "description": "페이지 이동 대기"
    },
    {
      "order": 5,
      "action": "assert",
      "type": "url_contains",
      "expected": "/projects/",
      "description": "프로젝트 페이지로 이동 확인"
    }
  ],

  "expectedResult": "최근 활동 항목 클릭 시 해당 프로젝트로 이동함",

  "createdAt": "2026-01-13T00:00:00Z",
  "updatedAt": "2026-01-13T00:00:00Z"
}
