{
  "id": "TC-DASH-001",
  "name": "대시보드 KPI 카드 표시 테스트",
  "description": "대시보드 페이지의 KPI 카드들이 올바르게 표시되는지 확인",
  "feature": "dashboard",
  "priority": "high",
  "tags": ["dashboard", "smoke", "kpi"],

  "preconditions": [
    "사용자가 로그인된 상태"
  ],

  "setup": {
    "requiresAuth": true,
    "startUrl": "/dashboard"
  },

  "steps": [
    {
      "order": 1,
      "action": "navigate",
      "target": "/dashboard",
      "description": "대시보드 페이지로 이동"
    },
    {
      "order": 2,
      "action": "wait",
      "type": "selector",
      "selector": "heading:has-text('Dashboard')",
      "description": "대시보드가 로드될 때까지 대기"
    },
    {
      "order": 3,
      "action": "assert",
      "type": "element_visible",
      "selector": ":text('프로젝트')",
      "description": "프로젝트 KPI 카드가 표시되는지 확인"
    },
    {
      "order": 4,
      "action": "assert",
      "type": "element_visible",
      "selector": ":text('수금 현황')",
      "description": "수금 현황 KPI 카드가 표시되는지 확인"
    },
    {
      "order": 5,
      "action": "assert",
      "type": "element_visible",
      "selector": ":text('인력')",
      "description": "인력 KPI 카드가 표시되는지 확인"
    },
    {
      "order": 6,
      "action": "assert",
      "type": "element_visible",
      "selector": ":text('태스크')",
      "description": "태스크 KPI 카드가 표시되는지 확인"
    },
    {
      "order": 7,
      "action": "assert",
      "type": "element_visible",
      "selector": ":text('최근 활동')",
      "description": "최근 활동 섹션이 표시되는지 확인"
    }
  ],

  "expectedResult": "대시보드의 모든 KPI 카드와 최근 활동 섹션이 올바르게 표시됨",

  "createdAt": "2026-01-13T00:00:00Z",
  "updatedAt": "2026-01-13T00:00:00Z"
}
