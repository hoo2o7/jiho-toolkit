{
  "id": "TC-NAV-002",
  "name": "Workforce 서브메뉴 네비게이션 테스트",
  "description": "Workforce 메뉴의 모든 서브메뉴가 올바르게 작동하는지 확인",
  "feature": "navigation",
  "priority": "high",
  "tags": ["navigation", "workforce", "submenu"],

  "preconditions": [
    "사용자가 로그인된 상태"
  ],

  "setup": {
    "requiresAuth": true,
    "startUrl": "/dashboard"
  },

  "steps": [
    {
      "order": 1,
      "action": "navigate",
      "target": "/dashboard",
      "description": "대시보드 페이지로 이동"
    },
    {
      "order": 2,
      "action": "click",
      "selector": "button:has-text('Workforce')",
      "description": "Workforce 메뉴 클릭"
    },
    {
      "order": 3,
      "action": "assert",
      "type": "element_visible",
      "selector": "link:has-text('캘린더')",
      "description": "캘린더 서브메뉴가 표시되는지 확인"
    },
    {
      "order": 4,
      "action": "assert",
      "type": "element_visible",
      "selector": "link:has-text('내 태스크')",
      "description": "내 태스크 서브메뉴가 표시되는지 확인"
    },
    {
      "order": 5,
      "action": "assert",
      "type": "element_visible",
      "selector": "link:has-text('리소스 관리')",
      "description": "리소스 관리 서브메뉴가 표시되는지 확인"
    },
    {
      "order": 6,
      "action": "assert",
      "type": "element_visible",
      "selector": "link:has-text('직원 관리')",
      "description": "직원 관리 서브메뉴가 표시되는지 확인"
    },
    {
      "order": 7,
      "action": "click",
      "selector": "link:has-text('내 태스크')",
      "description": "내 태스크 클릭"
    },
    {
      "order": 8,
      "action": "assert",
      "type": "url_contains",
      "expected": "/workforce/tasks",
      "description": "내 태스크 페이지로 이동 확인"
    },
    {
      "order": 9,
      "action": "click",
      "selector": "link:has-text('리소스 관리')",
      "description": "리소스 관리 클릭"
    },
    {
      "order": 10,
      "action": "assert",
      "type": "url_contains",
      "expected": "/workforce/resources",
      "description": "리소스 관리 페이지로 이동 확인"
    }
  ],

  "expectedResult": "Workforce의 모든 서브메뉴가 올바르게 작동하고 해당 페이지로 이동함",

  "createdAt": "2026-01-13T00:00:00Z",
  "updatedAt": "2026-01-13T00:00:00Z"
}
